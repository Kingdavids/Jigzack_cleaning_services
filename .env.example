# Copy to .env.local for local work. On Railway, set these as service variables.

# Supabase (Project settings > API). The anon key is safe in the browser;
# access is enforced by the row level security policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public address of the site, no trailing slash. Used in emails, the sitemap
# and social previews. Example: https://www.jigzackcleaningservices.com (the address that actually loads)
NEXT_PUBLIC_SITE_URL=

# Resend (email). RESEND_FROM_EMAIL must be on a domain verified in Resend,
# otherwise Resend only delivers to the account owner.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: comma separated inboxes for website enquiries. Falls back to the
# defaults in app/contact/actions.ts.
CONTACT_RECIPIENTS=

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Registration fee in naira, checked against the amount Paystack reports.
REGISTRATION_FEE_NGN=5000

# Optional: search engine ownership codes (Search Console and Bing Webmaster Tools).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Analytics
# only loads for visitors who accept the cookie notice.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Scheduled billing (daily job in .github/workflows/daily-billing.yml).
# The service role key is in Supabase, Project settings, API. Keep it secret:
# it bypasses all row level security. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. The same value goes in the GitHub repository secret CRON_SECRET.
CRON_SECRET=

# Optional: comma separated emails that get a message when a page or action crashes.
ERROR_ALERT_EMAILS=
