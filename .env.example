# Copy to .env.local for local work. On Railway, set these as service variables.

# Supabase (Project settings > API). The anon key is safe in the browser;
# access is enforced by the row level security policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public address of the site, no trailing slash. Used in emails, the sitemap
# and social previews. Example: https://jigzackcleaningservices.com
NEXT_PUBLIC_SITE_URL=

# Resend (email). RESEND_FROM_EMAIL must be on a domain verified in Resend,
# otherwise Resend only delivers to the account owner.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: comma separated inboxes for website enquiries. Falls back to the
# defaults in app/contact/actions.ts.
CONTACT_RECIPIENTS=

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Registration fee in naira, checked against the amount Paystack reports.
REGISTRATION_FEE_NGN=5000
